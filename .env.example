# ============================================================
#  Math Server — шаблон переменных окружения
#  Скопируй этот файл в .env и заполни реальными значениями.
# ============================================================

# Сервер
PORT=3001
NODE_ENV=development

# Разрешённые источники (сайт, программа)
# Через запятую, без пробелов
ALLOWED_ORIGINS=http://localhost:5173,https://valentinaborisovna971-rgb.github.io

# Resend — отправка email
# Получить ключ: https://resend.com → API Keys
RESEND_API_KEY=
FROM_EMAIL=onboarding@resend.dev

# Lemon Squeezy — приём оплат
# Получить секрет: Lemon Squeezy → Settings → Webhooks
LEMONSQUEEZY_WEBHOOK_SECRET=